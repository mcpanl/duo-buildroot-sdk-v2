<physical_partition type="spinand">
    <!-- U-Boot uses 9th block as fip backup. Keep first blocks reserved for fip. -->
    <!-- Temporary large ROOTFS slots; shrink later to match real NAND size. -->
    <partition label="fip" size_in_kb="5120" file="fip.bin"/>
    <partition label="BOOT" size_in_kb="8192" file="boot.spinand"/>
    <partition label="BOOT_B" size_in_kb="8192" file="boot_b.spinand"/>
    <partition label="MISC" size_in_kb="2048" file="logo.jpg" />
    <partition label="ENV" size_in_kb="128" file="" />
    <partition label="ENV_BAK" size_in_kb="128" file="" />
    <partition label="ROOTFS" size_in_kb="262144" file="rootfs.spinand" />
    <partition label="ROOTFS_B" size_in_kb="262144" file="rootfs_b.spinand" />
    <partition label="DATA" file="" mountpoint="/mnt/data" type="ubifs" />
</physical_partition>
