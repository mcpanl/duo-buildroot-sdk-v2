/dts-v1/;
#include "cv181x_base_riscv.dtsi"
#include "cv181x_asic_qfn.dtsi"
#include "cv181x_asic_sd.dtsi"
#include "cv181x_default_memmap.dtsi"
/ {
	model = "zcam";

	leds {
		compatible = "gpio-leds";
		led-user {
			gpios = <&porta 29 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "activity";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		user-button {
			label = "user-button";
			linux,code = <28>;
			gpios = <&portb 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
			wakeup-source;
		};
	};
};

&mipi_rx {
	snsr-reset = <&porta 2 GPIO_ACTIVE_LOW>, <&porta 2 GPIO_ACTIVE_LOW>, <&porta 2 GPIO_ACTIVE_LOW>;
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";

	gt9xx: gt9xx@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		goodix,irq-gpio = <&porta 18 0>;
		goodix,rst-gpio = <&porta 19 0>;
		status = "okay";
	};

	hynitron: hynitron@5a {
		compatible = "hynitron,hyn_ts", "hyn,7xx";
		reg = <0x5a>;
		irq-gpio = <&porta 18 0>;
		hynitron,irq-gpio = <&porta 18 0>;
		reset-gpio = <&porta 19 0>;
		hynitron,reset-gpio = <&porta 19 0>;
		max-touch-number = <5>;
		hynitron,max-touch-number = <5>;
		display-coords = <0 0 368 552>;
		hynitron,display-coords = <368 552>;
		pos-swap = <0>;
		posx-reverse = <0>;
		posy-reverse = <1>;
		status = "okay";
	};
};

