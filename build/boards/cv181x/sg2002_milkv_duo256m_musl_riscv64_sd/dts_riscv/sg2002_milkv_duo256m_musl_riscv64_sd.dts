/dts-v1/;
#include "cv181x_base_riscv.dtsi"
#include "cv181x_asic_qfn.dtsi"
#include "cv181x_asic_sd.dtsi"
#include "cv181x_default_memmap.dtsi"


/ {
	model = "Milk-V Duo256M";

        leds {
                compatible = "gpio-leds";
                led-user-milkv {
                        gpios = <&porte 2 GPIO_ACTIVE_HIGH>;
                        linux,default-trigger = "none";
                };

                led-user-maix {
                        gpios = <&porta 14 GPIO_ACTIVE_HIGH>;
                        linux,default-trigger = "activity";
                };
        };

	gpio-keys {
    		compatible = "gpio-keys";

    		user-button {
        		label = "user-button";
        		linux,code = <28>;
        		gpios = <&porta 30 GPIO_ACTIVE_LOW>;
        		debounce-interval = <10>;
			wakeup-source;
    		};
	};

};

&mipi_rx {
	snsr-reset = <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>, <&portc 17 GPIO_ACTIVE_LOW>;
};

&i2c0 {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

&spi2 {
	status = "okay";

	spidev@0 {
		status = "okay";
	};
};

&dac {
	mute-gpio-r = <&porte 1 GPIO_ACTIVE_LOW>;
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

