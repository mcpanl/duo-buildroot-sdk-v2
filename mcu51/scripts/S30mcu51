#!/bin/sh
#
# Start 8051 MCU with factory or runtime-updated firmware.
# Runs after S04data so /mnt/data may already be mounted.
#
# MCU owns GPIOE0 / PWR_GPIO0 status LED in the RTC power domain and never
# touches main-domain GPIOA. Default LED mode is blink (mode 0).
#

NAME=mcu51
UP=/usr/sbin/mcu51-up
LEDCTL=/usr/sbin/mcu51-ledctl
HB=/usr/sbin/mcu51-hb
RUNTIME_DIR=/mnt/data/mcu51
FACTORY_FW=/lib/firmware/mcu51/mars_mcu_fw.bin
REG_RTCSYS_RST=0x05025018
RST_HOLD=0x8107fffd

start() {
	if [ ! -x "$UP" ]; then
		echo "$NAME: $UP missing, skip"
		return 0
	fi
	if [ ! -e /dev/mem ]; then
		echo "$NAME: /dev/mem missing, skip"
		return 0
	fi
	if [ ! -f "$FACTORY_FW" ] && [ ! -f "$RUNTIME_DIR/mars_mcu_fw.bin" ]; then
		echo "$NAME: no firmware, skip"
		return 0
	fi

	mkdir -p "$RUNTIME_DIR" 2>/dev/null || true

	#
	# Image upgrades put a new factory FW in /lib/firmware while /mnt/data
	# may keep a stale runtime copy (preferred by mcu51-up). If factory is
	# newer than runtime, refresh runtime so the board runs the image FW.
	# Intentional hot-updates via mcu51-update still win when runtime is
	# newer than factory.
	#
	FORCE_RELOAD=""
	RT_FW="$RUNTIME_DIR/mars_mcu_fw.bin"
	if [ -f "$FACTORY_FW" ]; then
		if [ ! -f "$RT_FW" ] || [ "$FACTORY_FW" -nt "$RT_FW" ]; then
			cp -f "$FACTORY_FW" "$RT_FW" 2>/dev/null || true
			FORCE_RELOAD="-F"
			echo "$NAME: synced factory FW -> $RT_FW"
		fi
	fi

	echo -n "Starting $NAME: "
	# Default: skip SRAM rewrite if MCU already running (VBAT keep-alive),
	# unless we just synced a newer factory image (FORCE_RELOAD=-F).
	if "$UP" -q $FORCE_RELOAD; then
		# Default blink mode: 300ms on / 700ms off (preserves HB bits)
		if [ -x "$LEDCTL" ]; then
			"$LEDCTL" mode 0 >/dev/null 2>&1 || true
		fi
		# Optional heartbeat for status observation (MCU LED no longer
		# depends on HB ownership because it uses RTC GPIOE0).
		if [ -x "$HB" ]; then
			"$HB" start >/dev/null 2>&1 || true
		fi
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	echo -n "Stopping $NAME: "
	if [ -x "$HB" ]; then
		"$HB" stop >/dev/null 2>&1 || true
	fi
	# Hold 8051 in reset only (do NOT write 0 — that kills RTC fabric).
	if [ -e /dev/mem ] && command -v busybox >/dev/null 2>&1; then
		busybox devmem "$REG_RTCSYS_RST" 32 "$RST_HOLD" >/dev/null 2>&1 || true
	fi
	echo "OK"
}

case "$1" in
start)
	start
	;;
stop)
	stop
	;;
restart|reload)
	stop
	start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac

exit 0
