#!/bin/sh
#
# Early OTA hook: apply pending upgrade from /mnt/data before apps start.
#

. /usr/sbin/zonhor-ota-common.sh

case "$1" in
start)
	data_mount || {
		echo "S05ota: DATA mount failed, skipping"
		exit 0
	}

	if [ -f "$DATA_MNT/upgrade.pending" ] && [ -f "$DATA_MNT/upgrade.zip" ]; then
		echo "S05ota: pending upgrade detected, applying..."
		/usr/sbin/zonhor-ota-apply
		exit $?
	fi
	;;
stop)
	;;
restart|reload)
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac

exit 0
