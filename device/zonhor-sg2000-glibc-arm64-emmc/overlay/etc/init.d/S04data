#!/bin/sh
#
# Mount DATA partition for user data and OTA staging.
#

DATA_DEV="${ZONHOR_DATA_DEV:-/dev/mmcblk0p7}"
DATA_MNT=/mnt/data

case "$1" in
start)
	mkdir -p "$DATA_MNT"
	if [ -b "$DATA_DEV" ]; then
		e2fsck -y "$DATA_DEV" >/dev/null 2>&1
		if ! mount -t ext4 -o sync "$DATA_DEV" "$DATA_MNT" 2>/dev/null; then
			mke2fs -t ext4 -F -L DATA "$DATA_DEV" >/dev/null 2>&1
			mount -t ext4 -o sync "$DATA_DEV" "$DATA_MNT" 2>/dev/null || true
		fi
	fi
	;;
stop)
	if mountpoint -q "$DATA_MNT" && [ -b "$DATA_DEV" ]; then
		umount "$DATA_MNT" 2>/dev/null
	fi
	;;
restart|reload)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac

exit 0
