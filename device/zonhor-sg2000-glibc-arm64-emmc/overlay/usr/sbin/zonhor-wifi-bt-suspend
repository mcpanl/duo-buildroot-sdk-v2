#!/bin/sh
# Prepare AIC8800 WiFi/BT for system freeze/suspend, then enter sleep.
# Usage: zonhor-wifi-bt-suspend [freeze|mem]
#
# The shell blocks in `echo $MODE > /sys/power/state` until a wakeup
# (AXP2101 power key or RTC wakealarm). That is expected — not a hang.
#
# freeze (s2idle): keep drivers loaded; put WiFi in LP and clear bluesleep
# LPM so wakelocks cannot abort idle.
#
# mem (S2RAM): deep sleep resets SDIO/UART state for AIC8800. LP suspend
# via /proc/wifi_suspend already fails with "cmd queue crashed", and BlueZ
# HCI suspend times out — after wake WiFi SDIO wakeup and BT HCI are dead.
# Tear down the stack before mem and re-init after resume (same as boot).

MODE=${1:-freeze}
KO_DIR=/mnt/system/ko
BT_TTY=/dev/ttyS4
BT_BAUD=1500000
BL_SYS=/sys/class/backlight/fb_jd9853/bl_power
BL_SAVED=
WIFI_DHCPCD_STOPPED=
PM_DEBUG_SYS=/sys/power/pm_debug_messages
PM_DEBUG_SAVED=

mod_loaded() {
	lsmod | grep -q "^$1 "
}

lcd_bl_prepare_mem() {
	# Keep pad pull-down so GPIO float during S2RAM cannot light BL.
	if [ -x /usr/sbin/zonhor-lcd-bl-pad ]; then
		/usr/sbin/zonhor-lcd-bl-pad pulldown >/tmp/lcd-bl-pad.log 2>&1 || true
	fi
	if [ -e "${BL_SYS}" ]; then
		BL_SAVED=$(cat "${BL_SYS}" 2>/dev/null || echo "")
		# Force off before deep sleep (bl_power: 0=on, 1=off).
		echo 1 > "${BL_SYS}" 2>/dev/null || true
		echo "lcd: backlight off for mem (was ${BL_SAVED:-?})" >&2
	fi
}

lcd_bl_restore_mem() {
	if [ -n "${BL_SAVED}" ] && [ -e "${BL_SYS}" ]; then
		echo "${BL_SAVED}" > "${BL_SYS}" 2>/dev/null || true
		echo "lcd: backlight restored to bl_power=${BL_SAVED}" >&2
	elif [ -e "${BL_SYS}" ]; then
		# Default: stay off after mem unless userspace turns it on.
		echo 1 > "${BL_SYS}" 2>/dev/null || true
	fi
}

wifi_lp_suspend() {
	if [ -e /proc/wifi_suspend/suspend ]; then
		echo "wifi: set LP suspend" >&2
		echo 1 > /proc/wifi_suspend/suspend
	fi
}

wifi_lp_resume() {
	if [ -e /proc/wifi_suspend/suspend ]; then
		echo 0 > /proc/wifi_suspend/suspend
	fi
}

bt_clear_lpm() {
	if [ ! -e /proc/bluetooth/sleep/lpm ]; then
		return 0
	fi
	# Deassert HOST_WAKE_BT if protocol was armed, then stop LPM so the
	# bluesleep wakelock / rx_timer cannot keep aborting s2idle.
	if [ -e /proc/bluetooth/sleep/btwrite ]; then
		echo 0 > /proc/bluetooth/sleep/btwrite
	fi
	echo 0 > /proc/bluetooth/sleep/lpm
	echo "bt: bluesleep LPM off" >&2
	sleep 0.3
}

bt_stop() {
	echo "bt: stop HCI" >&2
	if command -v hciconfig >/dev/null 2>&1; then
		hciconfig hci0 down 2>/dev/null || true
	fi
	# Stop BlueZ attach so kernel HCI suspend is not attempted over UART.
	killall hciattach 2>/dev/null || true
	sleep 0.3
}

bt_start() {
	if [ ! -c "${BT_TTY}" ] || ! command -v hciattach >/dev/null 2>&1; then
		return 0
	fi
	i=0
	while [ $i -lt 20 ]; do
		[ -e /proc/bluetooth/sleep/lpm ] && break
		sleep 0.1
		i=$((i + 1))
	done
	killall hciattach 2>/dev/null || true
	sleep 0.2
	hciattach "${BT_TTY}" any ${BT_BAUD} flow >/tmp/hciattach-resume.log 2>&1 || \
		echo "bt: hciattach failed (see /tmp/hciattach-resume.log)" >&2
	sleep 0.5
	if command -v hciconfig >/dev/null 2>&1; then
		hciconfig hci0 up 2>/dev/null || true
	fi
}

wifi_clients_stop() {
	if command -v ifconfig >/dev/null 2>&1; then
		ifconfig wlan0 down 2>/dev/null || true
	fi

	if command -v dhcpcd >/dev/null 2>&1 &&
		command -v pidof >/dev/null 2>&1 &&
		pidof dhcpcd >/dev/null 2>&1; then
		dhcpcd -k wlan0 >/tmp/dhcpcd-wlan0-suspend.log 2>&1 && WIFI_DHCPCD_STOPPED=1
		sleep 0.3
	fi

	# Best-effort: iface holders block rmmod otherwise.
	killall udhcpc 2>/dev/null || true
	killall wpa_supplicant 2>/dev/null || true
	sleep 0.3
}

wifi_clients_start() {
	if [ -n "${WIFI_DHCPCD_STOPPED}" ] && command -v dhcpcd >/dev/null 2>&1; then
		dhcpcd wlan0 >/tmp/dhcpcd-wlan0-resume.log 2>&1 || \
			echo "wifi: dhcpcd wlan0 restart failed (see /tmp/dhcpcd-wlan0-resume.log)" >&2
	fi
}

wifi_bt_unload() {
	echo "wifi/bt: unload modules for mem" >&2
	wifi_clients_stop

	# Dependency order: btlpm -> fdrv -> bsp
	for tries in 1 2 3; do
		mod_loaded aic8800_btlpm && rmmod aic8800_btlpm 2>/dev/null || true
		mod_loaded aic8800_fdrv && rmmod aic8800_fdrv 2>/dev/null || true
		mod_loaded aic8800_bsp && rmmod aic8800_bsp 2>/dev/null || true
		if ! mod_loaded aic8800_bsp && ! mod_loaded aic8800_fdrv && ! mod_loaded aic8800_btlpm; then
			break
		fi
		sleep 0.5
	done
	if mod_loaded aic8800_bsp || mod_loaded aic8800_fdrv || mod_loaded aic8800_btlpm; then
		echo "wifi/bt: warning: some AIC modules still loaded" >&2
		lsmod | grep aic8800 >&2 || true
		return 1
	fi
	sleep 0.2
	return 0
}

wifi_bt_reload() {
	echo "wifi/bt: reload modules after mem" >&2
	if [ ! -f "${KO_DIR}/aic8800_bsp.ko" ]; then
		echo "wifi/bt: missing ${KO_DIR}/aic8800_bsp.ko" >&2
		return 1
	fi

	if ! mod_loaded aic8800_bsp; then
		insmod "${KO_DIR}/aic8800_bsp.ko" || {
			echo "wifi/bt: insmod aic8800_bsp failed" >&2
			return 1
		}
		sleep 0.5
	fi
	if ! mod_loaded aic8800_fdrv; then
		insmod "${KO_DIR}/aic8800_fdrv.ko" || {
			echo "wifi/bt: insmod aic8800_fdrv failed" >&2
			return 1
		}
		sleep 0.5
	fi
	if ! mod_loaded aic8800_btlpm; then
		insmod "${KO_DIR}/aic8800_btlpm.ko" || {
			echo "wifi/bt: insmod aic8800_btlpm failed" >&2
			return 1
		}
	fi

	if [ -x /usr/sbin/zonhor-mac-from-uid ]; then
		/usr/sbin/zonhor-mac-from-uid wlan0 2>/dev/null || true
	fi

	bt_start
	wifi_clients_start
	echo "wifi/bt: restore done" >&2
}

clear_wakeup_count() {
	if [ -r /sys/power/wakeup_count ]; then
		cnt=$(cat /sys/power/wakeup_count 2>/dev/null) || cnt=
		if [ -n "$cnt" ]; then
			echo "$cnt" > /sys/power/wakeup_count 2>/dev/null || true
		fi
	fi
}

pm_debug_prepare() {
	if [ -e "${PM_DEBUG_SYS}" ]; then
		PM_DEBUG_SAVED=$(cat "${PM_DEBUG_SYS}" 2>/dev/null || echo "")
		echo 1 > "${PM_DEBUG_SYS}" 2>/dev/null || true
	fi
}

pm_debug_restore() {
	if [ -n "${PM_DEBUG_SAVED}" ] && [ -e "${PM_DEBUG_SYS}" ]; then
		echo "${PM_DEBUG_SAVED}" > "${PM_DEBUG_SYS}" 2>/dev/null || true
	fi
}

pm_dump_wakeup_debug() {
	if [ -r /sys/power/pm_wakeup_irq ]; then
		irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo "")
		[ -n "${irq}" ] && echo "pm: wakeup irq ${irq}" >&2
	fi

	for ws in /sys/class/wakeup/*; do
		[ -d "${ws}" ] || continue
		name=$(cat "${ws}/name" 2>/dev/null || echo "")
		active=$(cat "${ws}/active_count" 2>/dev/null || echo "")
		event=$(cat "${ws}/event_count" 2>/dev/null || echo "")
		wakeup=$(cat "${ws}/wakeup_count" 2>/dev/null || echo "")
		[ -n "${name}" ] && echo "pm: wakeup source ${name} active=${active:-?} event=${event:-?} wakeup=${wakeup:-?}" >&2
	done
}

sync

case "${MODE}" in
mem)
	# Deep sleep: remove AIC8800 stack so SDIO/UART are not left half-dead.
	bt_stop
	if ! wifi_bt_unload; then
		echo "pm: abort mem because AIC modules are still busy" >&2
		wifi_clients_start
		exit 1
	fi
	lcd_bl_prepare_mem
	clear_wakeup_count
	pm_debug_prepare
	echo "pm: enter mem (wake with power key / RTC)" >&2
	echo mem > /sys/power/state
	rc=$?
	echo "pm: left mem rc=${rc}" >&2
	[ "${rc}" -ne 0 ] && pm_dump_wakeup_debug
	pm_debug_restore
	lcd_bl_restore_mem
	wifi_bt_reload
	exit $rc
	;;
freeze|*)
	bt_clear_lpm
	wifi_lp_suspend
	clear_wakeup_count
	pm_debug_prepare
	echo "pm: enter ${MODE} (wake with power key)" >&2
	echo "${MODE}" > /sys/power/state
	rc=$?
	echo "pm: left ${MODE} rc=${rc}" >&2
	[ "${rc}" -ne 0 ] && pm_dump_wakeup_debug
	pm_debug_restore
	wifi_lp_resume
	exit $rc
	;;
esac
