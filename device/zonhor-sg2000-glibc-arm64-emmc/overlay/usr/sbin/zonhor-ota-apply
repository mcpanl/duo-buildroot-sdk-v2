#!/bin/sh
#
# Apply a staged upgrade.zip to the inactive A/B slot.
#

. /usr/sbin/zonhor-ota-common.sh

OTA_FILE="$DATA_MNT/upgrade.zip"
OTA_PENDING="$DATA_MNT/upgrade.pending"
OTA_WORK="$DATA_MNT/work"
OTA_LOG="$DATA_MNT/upgrade.log"
OTA_FAIL="$DATA_MNT/upgrade.failed"

log() {
	echo "$(date '+%F %T') $*" | tee -a "$OTA_LOG"
}

fail() {
	log "ERROR: $*"
	ota_led_error
	touch "$OTA_FAIL" 2>/dev/null
	rm -f "$OTA_PENDING"
	sync 2>/dev/null
	exit "${2:-1}"
}

trap 'log "interrupted"; ota_led_stop; exit 130' INT TERM

data_mount || fail "cannot mount $DATA_MNT"

[ -f "$OTA_FILE" ] || fail "missing $OTA_FILE"
[ -f "$OTA_PENDING" ] || fail "missing $OTA_PENDING (run zonhor-ota-stage first)"

if ! command -v zonhor-ab-slot >/dev/null 2>&1; then
	fail "zonhor-ab-slot not installed"
fi

TARGET_SLOT=$(zonhor-ab-slot get-inactive) || fail "cannot determine inactive slot"
ACTIVE_SLOT=$(zonhor-ab-slot get-active) || fail "cannot determine active slot"

rm -f "$OTA_FAIL"
: >"$OTA_LOG"

log "OTA apply starting: active=$ACTIVE_SLOT target=$TARGET_SLOT"
ota_led_start phase1

rm -rf "$OTA_WORK"
mkdir -p "$OTA_WORK"

log "checking package metadata"
unzip -q -d "$OTA_WORK" "$OTA_FILE" META/misc_info.txt || fail "META/misc_info.txt missing"
# shellcheck disable=SC1090
. "$OTA_WORK/META/misc_info.txt"
[ "$STORAGE_TYPE" = "emmc" ] || fail "package STORAGE_TYPE=$STORAGE_TYPE, expected emmc"

log "unpacking $OTA_FILE"
unzip -o "$OTA_FILE" -d "$OTA_WORK" || fail "unzip failed"

METADATA="$OTA_WORK/META/metadata.txt"
[ -f "$METADATA" ] || fail "missing $METADATA"
chmod +x "$OTA_WORK/utils/cimg2raw" 2>/dev/null

log "verifying image checksums"
cd "$OTA_WORK" || fail "cannot enter $OTA_WORK"
md5sum -c META/metadata.txt >>"$OTA_LOG" 2>&1 || fail "checksum verification failed"

[ -f boot.emmc ] || fail "boot.emmc missing"
[ -f rootfs_ext4.emmc ] || fail "rootfs_ext4.emmc missing"

ota_cimg2raw boot.emmc || fail "cannot unpack boot image"
ota_cimg2raw rootfs_ext4.emmc || fail "cannot unpack rootfs image"
if [ -f logo.jpg ]; then
	ota_cimg2raw logo.jpg || fail "cannot unpack logo image"
fi

log "flashing inactive slot $TARGET_SLOT (boot + rootfs)"
zonhor-ab-slot flash-boot "$TARGET_SLOT" boot.emmc >>"$OTA_LOG" 2>&1 || fail "boot flash failed"
zonhor-ab-slot flash-rootfs "$TARGET_SLOT" rootfs_ext4.emmc >>"$OTA_LOG" 2>&1 || fail "rootfs flash failed"

if [ -f logo.jpg ]; then
	log "flashing shared MISC/logo"
	zonhor-ab-slot flash-misc logo.jpg >>"$OTA_LOG" 2>&1 || fail "misc flash failed"
fi

log "switching boot slot to $TARGET_SLOT"
zonhor-ab-slot set-boot-slot "$TARGET_SLOT" >>"$OTA_LOG" 2>&1 || fail "slot switch failed"

rm -f "$OTA_PENDING"
[ -f "$OTA_FILE" ] && mv -f "$OTA_FILE" "$DATA_MNT/upgrade.last.zip" 2>/dev/null
sync

log "OTA apply complete, rebooting into slot $TARGET_SLOT"
ota_led_stop
ota_led_success
reboot -f
