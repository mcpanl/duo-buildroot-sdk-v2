#!/bin/sh
#
# Stage an OTA package on /mnt/data for application on next reboot.
#
# Usage:
#   zonhor-ota-stage /path/to/upgrade.zip
#   zonhor-ota-stage              # use existing /mnt/data/upgrade.zip
#

. /usr/sbin/zonhor-ota-common.sh

OTA_FILE="$DATA_MNT/upgrade.zip"
OTA_PENDING="$DATA_MNT/upgrade.pending"

usage() {
	echo "Usage: $0 [upgrade.zip]"
	echo "  Copies package to $OTA_FILE and creates $OTA_PENDING."
	echo "  Reboot to apply: sync && reboot"
	exit 1
}

data_mount || {
	echo "cannot prepare $DATA_MNT"
	exit 1
}

SRC="$1"
if [ -n "$SRC" ]; then
	[ -f "$SRC" ] || {
		echo "file not found: $SRC"
		exit 1
	}
	echo "copying $SRC -> $OTA_FILE"
	cp -f "$SRC" "$OTA_FILE" || exit 1
elif [ ! -f "$OTA_FILE" ]; then
	usage
fi

rm -f "$DATA_MNT/upgrade.failed"
touch "$OTA_PENDING"
sync

ota_led_start staged

echo "OTA package staged."
echo "  package : $OTA_FILE"
echo "  marker  : $OTA_PENDING"
echo "  active  : $(zonhor-ab-slot get-active 2>/dev/null || echo unknown)"
echo "  target  : $(zonhor-ab-slot get-inactive 2>/dev/null || echo unknown)"
echo "Run: sync && reboot"
