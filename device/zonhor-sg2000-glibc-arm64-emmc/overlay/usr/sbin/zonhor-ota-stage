#!/bin/sh
#
# Stage an OTA package on /mnt/data for application on next reboot.
#
# Unpacks / verifies / converts images here (live system) so the post-reboot
# apply phase only flashes the inactive slot.
#
# Usage:
#   zonhor-ota-stage /path/to/upgrade.zip
#   zonhor-ota-stage              # use existing /mnt/data/upgrade.zip
#

. /usr/sbin/zonhor-ota-common.sh

usage() {
	echo "Usage: $0 [upgrade.zip]"
	echo "  Copies package to $OTA_FILE, unpacks+converts into $OTA_WORK,"
	echo "  then creates $OTA_PENDING."
	echo "  Reboot to apply: sync && reboot"
	exit 1
}

fail() {
	echo "ERROR: $*"
	ota_prepare_log "ERROR: $*"
	ota_ui_error "$*"
	ota_led_error
	rm -f "$OTA_PENDING"
	touch "$OTA_FAIL" 2>/dev/null
	sync 2>/dev/null
	sleep 2
	ota_ui_stop
	exit 1
}

data_mount || {
	echo "cannot prepare $DATA_MNT"
	exit 1
}

SRC="$1"
if [ -n "$SRC" ]; then
	[ -f "$SRC" ] || {
		echo "file not found: $SRC"
		exit 1
	}
	# Already staged at the destination path — skip copy.
	src_real=$(realpath "$SRC" 2>/dev/null || echo "$SRC")
	dst_real=$(realpath "$OTA_FILE" 2>/dev/null || echo "$OTA_FILE")
	if [ "$src_real" = "$dst_real" ]; then
		echo "using existing $OTA_FILE"
	else
		echo "copying $SRC -> $OTA_FILE"
		cp -f "$SRC" "$OTA_FILE" || exit 1
	fi
elif [ ! -f "$OTA_FILE" ]; then
	usage
fi

rm -f "$OTA_FAIL" "$OTA_PENDING"
: >"$OTA_LOG"
rm -rf "$OTA_WORK"

ACTIVE=$(zonhor-ab-slot get-active 2>/dev/null || echo a)
TARGET=$(zonhor-ab-slot get-inactive 2>/dev/null || echo b)

ota_led_start staged
ota_ui_start "$ACTIVE" "$TARGET"
ota_ui_update CHECK 3 "prepare"

echo "preparing OTA images under $OTA_WORK (unzip + verify + convert)..."
# Capture the failure reason (last echo from ota_prepare_work) while still
# streaming progress logs to the terminal via tee inside ota_prepare_log.
if ! ota_prepare_work; then
	reason=$(grep '^.* ERROR: ' "$OTA_LOG" 2>/dev/null | tail -n 1 | sed 's/^.* ERROR: //')
	fail "${reason:-prepare failed (see $OTA_LOG)}"
fi

touch "$OTA_PENDING"
sync

ota_ui_update SWITCH 100 "staged"
ota_ui_staged "$ACTIVE" "$TARGET"
ota_ui_stop
# Keep slow blink until reboot applies the update.
ota_led_start staged

echo "OTA package staged (images pre-unpacked)."
echo "  package : $OTA_FILE"
echo "  work    : $OTA_WORK"
echo "  marker  : $OTA_PENDING"
echo "  active  : $ACTIVE"
echo "  target  : $TARGET"
echo "Run: sync && reboot"
